{
  "name": "@local/dsh-tool-imagegen",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Github-CJX/dsh-tool-imagegen.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "image-generation",
    "image-to-image",
    "openai-compatible",
    "plugin",
    "dsh-plugin"
  ],
  "type": "module",
  "description": "DSH 对话内联生图插件：OpenAI 兼容接口，图片以 generated-image 块直接显示在对话框内，设置项在 设置→插件→可配置。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.8",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "react": "^18.3.1",
    "rolldown": "^1.2.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-attachment"
      ],
      "platform": "web"
    }
  }
}
